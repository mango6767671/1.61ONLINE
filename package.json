{
  "name": "gta-online-community-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Independent community backend foundation for a GTA V 1.61-compatible multiplayer project.",
  "license": "UNLICENSED",
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx scripts/migrate.ts",
    "bot:dev": "tsx watch bot/index.ts",
    "bot:start": "tsx bot/index.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.2.0",
    "@fastify/jwt": "^9.1.0",
    "@fastify/rate-limit": "^10.2.1",
    "argon2": "^0.41.1",
    "discord.js": "^14.22.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
