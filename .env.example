NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/online
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters-long
DISCORD_BOT_API_KEY=replace-with-a-separate-random-secret-at-least-32-characters
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

